--- a/hw/sd/ingenic-msc.c
+++ b/hw/sd/ingenic-msc.c
@@ -163,6 +163,12 @@ static void ingenic_msc_run_command(IngenicMscState *s)
     } else {
         s->data_total = 0;
         s->data_pos = 0;
+        /*
+         * The SD bus completes commands synchronously. Signal the end of
+         * the busy period for R1b commands such as STOP_TRANSMISSION.
+         */
+        if ((cmdat & CMDAT_BUSY) && rsplen)
+            s->reg_iflg |= IFLG_PRG_DONE;
     }
 }
 
